{
  "name": "mp-shared",
  "version": "2.1.17",
  "scripts": {
    "dev": "tsc --watch",
    "docs": "node ./scripts/docs.js",
    "docs:notion": "node ./scripts/docs.js --notion",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "build": "rm -rf ./dist && tsc && node ./scripts/package.js"
  },
  "dependencies": {
    "@date-fns/utc": "^2.1.1",
    "class-transformer": "^0.5.1",
    "date-fns": "^4.4.0",
    "prettier": "^3.9.10"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.4",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
