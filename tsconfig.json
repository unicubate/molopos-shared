{
    "include": [
        "./src/**/*"
    ],
    "exclude": [
        "./src/**/*.test.ts"
    ],
    "compilerOptions": {
        "target": "ES2023",
        "lib": ["ES2023", "DOM"],
        "module": "CommonJS",
        "moduleResolution": "bundler",
        "rootDir": "./src",
        "outDir": "./dist",
        "declaration": true,
        "skipLibCheck": true,
        "strict": false,
        "types": ["node"]
    }
}
